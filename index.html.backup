                { id: 13, name: 'Phở trâu tươi', price: 35000, description: 'Bánh phở mềm kết hợp cùng thịt trâu tươi và nước dùng thơm ngon.', icon: '🍜' },
                { id: 14, name: 'Phở trâu đặc biệt', price: 50000, description: 'Tô phở đặc biệt với nhiều nguyên liệu hấp dẫn.', icon: '🍜' },
                { id: 15, name: 'Phở trâu xào', price: 50000, description: 'Bánh phở được xào cùng thịt trâu tươi và rau.', icon: '🍜' },
                { id: 16, name: 'Mì trâu xào', price: 50000, description: 'Mì xào thơm ngon kết hợp cùng thịt trâu tươi.', icon: '🍝' },
                { id: 17, name: 'Phở trâu chiên giòn', price: 100000, description: 'Bánh phở chiên giòn, kết hợp cùng thịt trâu và nước sốt đậm đà.', icon: '🍜' },
                { id: 18, name: 'Bánh bao trâu', price: 100000, description: 'Bánh bao nóng hổi với nhân thịt trâu.', icon: '🥟' },
                { id: 19, name: 'Quẩy', price: 10000, description: 'Quẩy giòn thơm, phù hợp ăn kèm phở.', icon: '🥖' }
            ],
            'Đồ uống': [
                { id: 20, name: 'Nước lọc', price: 10000, description: '', icon: '💧' },
                { id: 21, name: 'Nước ngọt các loại', price: 20000, description: '', icon: '🥤' },
                { id: 22, name: 'Rượu men lá', price: 30000, description: '', icon: '🍶' },
                { id: 23, name: 'Rượu nếp cái', price: 30000, description: '', icon: '🍶' },
                { id: 24, name: 'Rượu ba kích', price: 30000, description: '', icon: '🍶' }
            ]
        };

        let cart = [];
        let currentOrderType = 'dine-in';
        let orders = [
            { id: 'DH001', customer: 'Nguyễn Văn A', phone: '0912345678', total: 508000, type: 'Giao hàng', status: 'new' },
            { id: 'DH002', customer: 'Trần Thị B', phone: '0987654321', total: 349000, type: 'Mang về', status: 'confirmed' },
            { id: 'DH003', customer: 'Lê Văn C', phone: '0901234567', total: 159000, type: 'Tại nhà hàng', status: 'preparing' }
        ];
        let reservations = [
            { name: 'Phạm Thị D', phone: '0909876543', date: '2026-09-05', time: '18:00', guests: 6, notes: 'Muốn ngồi ngoài trời' },
            { name: 'Hoàng Văn E', phone: '0912223334', date: '2026-09-03', time: '12:00', guests: 4, notes: 'Gia đình có trẻ nhỏ' }
        ];

        function navigateTo(page, category = null) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.getElementById(page + 'Page').classList.add('active');

            if (page === 'menu') {
                renderMenu(category);
            } else if (page === 'cart') {
                renderCart();
            } else if (page === 'checkout') {
                renderCheckoutSummary();
            }

            window.scrollTo(0, 0);
        }

        function renderFeaturedDishes() {
            const featured = [
                menuData['Các món về trâu'][0],
                menuData['Các món về trâu'][1],
                menuData['Các món về trâu'][3],
                menuData['Các món về trâu'][4],
                menuData['Lẩu'][1],
                menuData['Các món phở'][1]
            ];

            const container = document.getElementById('featuredDishes');
            container.innerHTML = featured.map(dish => createDishCard(dish)).join('');
        }

        function createDishCard(dish) {
            const priceDisplay = typeof dish.price === 'number'
                ? new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(dish.price)
                : dish.price;

            return `
                <div class="dish-card">
                    <div class="dish-image">${dish.icon}</div>
                    <div class="dish-content">
                        <h3>${dish.name}</h3>
                        ${dish.description ? `<p class="dish-description">${dish.description}</p>` : ''}
                        <div class="dish-footer">
                            <span class="dish-price">${priceDisplay}</span>
                            <button class="btn-add-cart" onclick="addToCart(${dish.id})">+ THÊM</button>
                        </div>
                    </div>
                </div>
            `;
        }

        function renderMenu(initialCategory = null) {
            const tabsContainer = document.getElementById('categoryTabs');
            const categories = Object.keys(menuData);

            tabsContainer.innerHTML = categories.map(cat =>
                `<div class="category-tab ${initialCategory === cat || (!initialCategory && cat === categories[0]) ? 'active' : ''}"
                      onclick="filterByCategory('${cat}')">${cat.toUpperCase()}</div>`
            ).join('');

            filterByCategory(initialCategory || categories[0]);

            document.getElementById('menuSearch').addEventListener('input', (e) => {
                const searchTerm = e.target.value.toLowerCase();
                searchMenu(searchTerm);
            });
        }

        function filterByCategory(category) {
            document.querySelectorAll('.category-tab').forEach(tab => {
                tab.classList.remove('active');
                if (tab.textContent.toLowerCase() === category.toLowerCase()) {
                    tab.classList.add('active');
                }
            });

            const container = document.getElementById('menuDishes');
            const dishes = menuData[category];
            container.innerHTML = dishes.map(dish => createDishCard(dish)).join('');
        }

        function searchMenu(term) {
            if (!term) {
                const activeTab = document.querySelector('.category-tab.active');
                const category = activeTab ? activeTab.textContent.toLowerCase() : Object.keys(menuData)[0];
                filterByCategory(category);
                return;
            }

            const allDishes = Object.values(menuData).flat();
            const filtered = allDishes.filter(dish =>
                dish.name.toLowerCase().includes(term) ||
                (dish.description && dish.description.toLowerCase().includes(term))
            );

            const container = document.getElementById('menuDishes');
            container.innerHTML = filtered.length
                ? filtered.map(dish => createDishCard(dish)).join('')
                : '<p style="text-align: center; grid-column: 1/-1; font-size: 1.2rem; color: #666;">Không tìm thấy món ăn.</p>';
        }

        function addToCart(dishId) {
            const allDishes = Object.values(menuData).flat();
            const dish = allDishes.find(d => d.id === dishId);

            const existingItem = cart.find(item => item.id === dishId);
            if (existingItem) {
                existingItem.qty++;
            } else {
                cart.push({ ...dish, qty: 1 });
            }

            updateCartBadge();

            const notification = document.createElement('div');
            notification.style.cssText = 'position: fixed; top: 100px; right: 20px; background: var(--primary); color: white; padding: 1rem 2rem; border-radius: 8px; z-index: 9999; box-shadow: 0 4px 20px rgba(0,0,0,0.2);';
            notification.textContent = `✓ Đã thêm ${dish.name} vào giỏ hàng`;
            document.body.appendChild(notification);
            setTimeout(() => notification.remove(), 2000);
        }

        function updateCartBadge() {
            const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById('cartBadge').textContent = totalItems;
            document.getElementById('mobileCartBadge').textContent = totalItems;
        }

        function renderCart() {
            const container = document.getElementById('cartContent');

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="cart-empty">
                        <div class="cart-empty-icon">🛒</div>
                        <h2>Giỏ hàng của bạn đang trống</h2>
                        <p>Hãy khám phá thực đơn và thêm món ăn yêu thích!</p>
                        <button class="btn-primary" onclick="navigateTo('menu')" style="margin-top: 1rem;">XEM THỰC ĐƠN</button>
                    </div>
                `;
                return;
            }

            const subtotal = cart.reduce((sum, item) => {
                const price = typeof item.price === 'number' ? item.price : 0;
                return sum + (price * item.qty);
            }, 0);

            const deliveryFee = currentOrderType === 'delivery' ? 30000 : 0;
            const total = subtotal + deliveryFee;

            container.innerHTML = `
                <div class="cart-items">
                    ${cart.map((item, index) => {
                        const priceDisplay = typeof item.price === 'number'
                            ? new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.price)
                            : item.price;

                        return `
                            <div class="cart-item">
                                <div class="cart-item-icon">${item.icon}</div>
                                <div class="cart-item-details">
                                    <div class="cart-item-name">${item.name}</div>
                                    <div class="cart-item-price">${priceDisplay}</div>
                                    <div class="quantity-controls">
                                        <button class="qty-btn" onclick="updateQty(${index}, -1)">-</button>
                                        <span class="qty-display">${item.qty}</span>
                                        <button class="qty-btn" onclick="updateQty(${index}, 1)">+</button>
                                    </div>
                                </div>
                                <button class="cart-item-remove" onclick="removeFromCart(${index})">Xóa</button>
                            </div>
                        `;
                    }).join('')}
                </div>

                <div class="cart-summary">
                    <div class="summary-row">
                        <span>Tạm tính</span>
                        <span>${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(subtotal)}</span>
                    </div>
                    ${deliveryFee > 0 ? `
                        <div class="summary-row">
                            <span>Phí giao hàng</span>
                            <span>${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(deliveryFee)}</span>
                        </div>
                    ` : ''}
                    <div class="summary-row total">
                        <span>TỔNG CỘNG</span>
                        <span>${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(total)}</span>
                    </div>
                </div>

                <div style="text-align: center; margin-top: 2rem;">
                    <button class="btn-secondary" onclick="navigateTo('menu')" style="margin-right: 1rem;">TIẾP TỤC ĐẶT MÓN</button>
                    <button class="btn-primary" onclick="navigateTo('checkout')">THANH TOÁN</button>
                </div>
            `;
        }

        function updateQty(index, change) {
            cart[index].qty += change;
            if (cart[index].qty <= 0) {
                cart.splice(index, 1);
            }
            updateCartBadge();
            renderCart();
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartBadge();
            renderCart();
        }

        function selectOrderType(type) {
            currentOrderType = type;
            document.querySelectorAll('.order-type-option').forEach(opt => opt.classList.remove('selected'));
            event.target.closest('.order-type-option').classList.add('selected');

            const deliveryGroup = document.getElementById('deliveryAddressGroup');
            if (type === 'delivery') {
                deliveryGroup.classList.remove('hidden');
            } else {
                deliveryGroup.classList.add('hidden');
            }

            renderCheckoutSummary();
        }

        function renderCheckoutSummary() {
            const subtotal = cart.reduce((sum, item) => {
                const price = typeof item.price === 'number' ? item.price : 0;
                return sum + (price * item.qty);
            }, 0);

            const deliveryFee = currentOrderType === 'delivery' ? 30000 : 0;
            const total = subtotal + deliveryFee;

            document.getElementById('checkoutSummary').innerHTML = `
                <h4>Tóm tắt đơn hàng</h4>
                ${cart.map(item => `
                    <div style="display: flex; justify-content: space-between; margin: 0.5rem 0;">
                        <span>${item.name} x${item.qty}</span>
                        <span>${typeof item.price === 'number' ? new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.price * item.qty) : item.price}</span>
                    </div>
                `).join('')}
                <hr style="margin: 1rem 0; border: none; border-top: 1px solid rgba(0,0,0,0.1);">
                <div style="display: flex; justify-content: space-between; margin: 0.5rem 0;">
                    <span>Tạm tính</span>
                    <span>${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(subtotal)}</span>
                </div>
                ${deliveryFee > 0 ? `
                    <div style="display: flex; justify-content: space-between; margin: 0.5rem 0;">
                        <span>Phí giao hàng</span>
                        <span>${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(deliveryFee)}</span>
                    </div>
                ` : ''}
                <div style="display: flex; justify-content: space-between; margin-top: 1rem; font-size: 1.3rem; font-weight: 700; color: var(--primary);">
                    <span>TỔNG</span>
                    <span>${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(total)}</span>
                </div>
            `;
        }

        function confirmOrder() {
            const name = document.getElementById('customerName').value;
            const phone = document.getElementById('customerPhone').value;

            if (!name || !phone) {
                alert('Vui lòng điền đầy đủ thông tin!');
                return;
            }

            if (currentOrderType === 'delivery' && !document.getElementById('deliveryAddress').value) {
                alert('Vui lòng nhập địa chỉ giao hàng!');
                return;
            }

            const orderId = 'DH' + Math.floor(Math.random() * 10000).toString().padStart(4, '0');
            const subtotal = cart.reduce((sum, item) => {
                const price = typeof item.price === 'number' ? item.price : 0;
                return sum + (price * item.qty);
            }, 0);
            const deliveryFee = currentOrderType === 'delivery' ? 30000 : 0;
            const total = subtotal + deliveryFee;

            const orderTypeLabels = {
                'dine-in': 'Ăn tại nhà hàng',
                'takeaway': 'Mang về',
                'delivery': 'Giao hàng'
            };

            orders.push({
                id: orderId,
                customer: name,
                phone: phone,
                total: total,
                type: orderTypeLabels[currentOrderType],
                status: 'new'
            });

            document.getElementById('displayOrderId').textContent = `Mã đơn hàng: ${orderId}`;
            document.getElementById('orderDetailsDisplay').innerHTML = `
                <h3 style="margin-bottom: 1rem;">Chi tiết đơn hàng</h3>
                ${cart.map(item => `
                    <div style="display: flex; justify-content: space-between; margin: 0.5rem 0;">
                        <span>${item.name} x${item.qty}</span>
                        <span>${typeof item.price === 'number' ? new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.price * item.qty) : item.price}</span>
                    </div>
                `).join('')}
                <hr style="margin: 1rem 0;">
                <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 1.2rem; color: var(--primary);">
                    <span>Tổng cộng</span>
                    <span>${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(total)}</span>
                </div>
                <p style="margin-top: 1rem;"><strong>Loại:</strong> ${orderTypeLabels[currentOrderType]}</p>
                <p><strong>Trạng thái:</strong> Đã nhận đơn</p>
            `;

            cart = [];
            updateCartBadge();
            navigateTo('confirmation');
        }

        function submitReservation() {
            const name = document.getElementById('reservationName').value;
            const phone = document.getElementById('reservationPhone').value;
            const date = document.getElementById('reservationDate').value;
            const time = document.getElementById('reservationTime').value;
            const guests = document.getElementById('reservationGuests').value;

            if (!name || !phone || !date || !time || !guests) {
                alert('Vui lòng điền đầy đủ thông tin!');
                return;
            }

            reservations.push({
                name, phone, date, time, guests,
                notes: document.getElementById('reservationNotes').value
            });

            alert('Cảm ơn bạn!\n\nNhà hàng sẽ liên hệ xác nhận đặt bàn trong thời gian sớm nhất.');

            document.getElementById('reservationName').value = '';
            document.getElementById('reservationPhone').value = '';
            document.getElementById('reservationDate').value = '';
            document.getElementById('reservationTime').value = '';
            document.getElementById('reservationGuests').value = '';
            document.getElementById('reservationNotes').value = '';
        }

        function adminLogin() {
            const password = document.getElementById('adminPassword').value;
            if (password === 'admin123') {
                document.getElementById('adminLogin').classList.add('hidden');
                document.getElementById('adminDashboard').classList.remove('hidden');
                renderAdminDashboard();
            } else {
                alert('Mật khẩu không đúng!');
            }
        }

        function adminLogout() {
            document.getElementById('adminLogin').classList.remove('hidden');
            document.getElementById('adminDashboard').classList.add('hidden');
            document.getElementById('adminPassword').value = '';
        }

        function renderAdminDashboard() {
            const today = new Date().toISOString().split('T')[0];
            const todayOrders = orders.filter(o => true);
            const totalRevenue = todayOrders.reduce((sum, o) => sum + o.total, 0);

            document.getElementById('statOrdersToday').textContent = todayOrders.length;
            document.getElementById('statRevenue').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(totalRevenue);
            document.getElementById('statTotalOrders').textContent = orders.length;
            document.getElementById('statPopularItem').textContent = 'Trâu xào cháy tỏi';

            const statusLabels = {
                'new': 'Mới',
                'confirmed': 'Đã xác nhận',
                'preparing': 'Đang chuẩn bị',
                'completed': 'Hoàn thành'
            };

            document.getElementById('ordersTableBody').innerHTML = orders.map(order => `
                <tr>
                    <td><strong>${order.id}</strong></td>
                    <td>${order.customer}</td>
                    <td>${order.phone}</td>
                    <td>${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(order.total)}</td>
                    <td>${order.type}</td>
                    <td><span class="status-badge status-${order.status}">${statusLabels[order.status]}</span></td>
                </tr>
            `).join('');

            document.getElementById('reservationsTableBody').innerHTML = reservations.map(res => `
                <tr>
                    <td>${res.name}</td>
                    <td>${res.phone}</td>
                    <td>${res.date}</td>
                    <td>${res.time}</td>
                    <td>${res.guests}</td>
                    <td>${res.notes || '-'}</td>
                </tr>
            `).join('');
        }

        window.addEventListener('scroll', () => {
            const navbar = document.getElementById('navbar');
            if (window.scrollY > 100) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });

        renderFeaturedDishes();
        updateCartBadge();
    </script>
</body>
</html>