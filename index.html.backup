    <div id="checkoutPage" class="page checkout-page">
        <div class="container">
            <h1 class="page-title">THANH TOÁN</h1>
            <div class="checkout-form">
                <h3 style="margin-bottom: 1.5rem;">Thông tin khách hàng</h3>
                <div class="form-group">
                    <label>Họ và tên *</label>
                    <input type="text" class="form-input" id="customerName" required>
                </div>
                <div class="form-group">
                    <label>Số điện thoại *</label>
                    <input type="tel" class="form-input" id="customerPhone" required>
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" class="form-input" id="customerEmail">
                </div>

                <h3 style="margin: 2rem 0 1rem;">Hình thức đặt món</h3>
                <div class="order-type-selector">
                    <div class="order-type-option selected" onclick="selectOrderType('dine-in')">
                        <div class="icon">🍽</div>
                        <div>Ăn tại nhà hàng</div>
                    </div>
                    <div class="order-type-option" onclick="selectOrderType('takeaway')">
                        <div class="icon">🥡</div>
                        <div>Mang về</div>
                    </div>
                    <div class="order-type-option" onclick="selectOrderType('delivery')">
                        <div class="icon">🛵</div>
                        <div>Giao hàng</div>
                    </div>
                </div>

                <div id="deliveryAddressGroup" class="form-group hidden">
                    <label>Địa chỉ giao hàng *</label>
                    <textarea class="form-input" id="deliveryAddress"></textarea>
                </div>

                <div class="form-group">
                    <label>Ghi chú cho nhà hàng</label>
                    <textarea class="form-input" id="orderNotes" placeholder="Ví dụ: Không cay, ít hành..."></textarea>
                    <small>Yêu cầu đặc biệt sẽ được nhà hàng hỗ trợ tùy theo khả năng phục vụ.</small>
                </div>

                <div id="checkoutSummary" style="background: var(--bg-cream); padding: 1.5rem; border-radius: 8px; margin: 2rem 0;"></div>

                <button class="btn-primary" style="width: 100%; font-size: 1.1rem; padding: 1rem;" onclick="confirmOrder()">
                    XÁC NHẬN ĐƠN HÀNG
                </button>
            </div>
        </div>
    </div>

